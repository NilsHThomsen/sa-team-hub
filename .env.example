# Postgres. On Vercel, adding Neon from the Marketplace sets DATABASE_URL for you.
DATABASE_URL=postgres://postgres@localhost:5432/teamhub

# Signs the session cookie shared by the dashboard and the agent. At least 32 characters.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Shared password for the demo sign-in page.
DEMO_PASSWORD=team-hub-demo

# AI Gateway. Not needed on Vercel (OIDC is used); set it for local runs.
AI_GATEWAY_API_KEY=
